---
// Preloader: counter to 100, then one mask wipe. Driven by src/scripts/motion.ts.
---

<div class="preloader" id="preloader" role="status" aria-live="polite">
  <button class="preloader__skip" type="button" data-skip>Skip</button>
  <div class="preloader__row">
    <p class="preloader__label">Loading</p>
    <p class="preloader__count"><span data-count>00</span></p>
  </div>
  <div class="preloader__bar"><span data-bar></span></div>
</div>
